# Copy to .env and adjust. Values below are local-dev defaults (host -> compose services).
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://inventory:inventory@localhost:5432/inventory
REDIS_URL=redis://localhost:6379/0

# Used by docker-compose only
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Auth. DEV ONLY - generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789

# First admin, created on startup if missing (never overwritten). DEV ONLY values.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin-dev-password

# Low-stock alert recipient (logged, not actually emailed)
LOW_STOCK_ALERT_EMAIL=inventory-alerts@example.com

# Movement transactions per employee per sliding window
RATE_LIMIT_MAX_REQUESTS=50
RATE_LIMIT_WINDOW_S=60

# Demo storekeeper created by 'python -m src.seed' (dev only; the seed refuses production)
SEED_STOREKEEPER_PASSWORD=storekeeper-pass
